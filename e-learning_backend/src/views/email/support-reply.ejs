<!doctype html>
<html
    lang="en"
    xmlns="http://www.w3.org/1999/xhtml"
    xmlns:v="urn:schemas-microsoft-com:vml"
    xmlns:o="urn:schemas-microsoft-com:office:office"
>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta http-equiv="X-UA-Compatible" content="IE=edge" />
        <meta name="x-apple-disable-message-reformatting" />
        <meta name="color-scheme" content="light" />
        <title>Support Ticket Reply</title>

        <!--[if mso]>
            <noscript
                ><xml
                    ><o:OfficeDocumentSettings
                        ><o:AllowPNG /><o:PixelsPerInch
                            >96</o:PixelsPerInch
                        ></o:OfficeDocumentSettings
                    ></xml
                ></noscript
            >
            <style>
                table {
                    border-collapse: collapse;
                    mso-table-lspace: 0pt;
                    mso-table-rspace: 0pt;
                }
                td {
                    font-family: Arial, sans-serif;
                }
            </style>
        <![endif]-->

        <style>
            body,
            table,
            td,
            a {
                -webkit-text-size-adjust: 100%;
                -ms-text-size-adjust: 100%;
            }
            body {
                margin: 0 !important;
                padding: 0 !important;
                width: 100% !important;
                background-color: #f0f2f5;
            }
            a[x-apple-data-detectors] {
                color: inherit !important;
                text-decoration: none !important;
            }

            /* Mobile-first */
            .email-container {
                width: 100% !important;
            }
            .content-padding {
                padding: 24px 18px !important;
            }
            .header-cell {
                padding: 28px 18px !important;
            }
            .footer-cell {
                padding: 18px 18px 22px !important;
            }
            .header-title {
                font-size: 20px !important;
            }
            .header-subtitle {
                font-size: 13px !important;
            }
            .divider-pad {
                padding: 0 18px !important;
            }
            .sub-footer {
                padding: 20px 18px 0 !important;
            }
            .ticket-box {
                padding: 16px 18px !important;
            }
            .ticket-label {
                font-size: 13px !important;
            }
            .fallback-url {
                font-size: 11px !important;
            }

            @media only screen and (min-width: 620px) {
                .email-container {
                    width: 600px !important;
                    max-width: 600px !important;
                }
                .content-padding {
                    padding: 36px 40px !important;
                }
                .header-cell {
                    padding: 36px 40px !important;
                }
                .footer-cell {
                    padding: 24px 40px 28px !important;
                }
                .header-title {
                    font-size: 24px !important;
                }
                .header-subtitle {
                    font-size: 14px !important;
                }
                .divider-pad {
                    padding: 0 40px !important;
                }
                .sub-footer {
                    padding: 24px 16px 0 !important;
                }
                .ticket-box {
                    padding: 20px 24px !important;
                }
                .ticket-label {
                    font-size: 14px !important;
                }
                .fallback-url {
                    font-size: 12px !important;
                }
            }
        </style>
    </head>
    <body style="margin: 0; padding: 0; background-color: #f0f2f5">
        <table
            role="presentation"
            cellspacing="0"
            cellpadding="0"
            border="0"
            width="100%"
            style="background-color: #f0f2f5"
        >
            <tr>
                <td align="center" style="padding: 20px 0">
                    <!-- Email Container -->
                    <table
                        role="presentation"
                        cellspacing="0"
                        cellpadding="0"
                        border="0"
                        width="600"
                        class="email-container"
                        style="width: 600px; max-width: 600px"
                    >
                        <!-- Header -->
                        <tr>
                            <td
                                class="header-cell"
                                style="padding: 36px 40px; background-color: #4f46e5"
                            >
                                <table
                                    role="presentation"
                                    cellspacing="0"
                                    cellpadding="0"
                                    border="0"
                                    width="100%"
                                >
                                    <tr>
                                        <td style="padding: 0 0 8px 0">
                                            <h1
                                                style="
                                                    margin: 0;
                                                    color: #ffffff;
                                                    font-family: Arial, Helvetica, sans-serif;
                                                    font-size: 24px;
                                                    font-weight: bold;
                                                "
                                            >
                                                Support Ticket Reply
                                            </h1>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 0">
                                            <p
                                                style="
                                                    margin: 0;
                                                    color: rgba(255, 255, 255, 0.9);
                                                    font-family: Arial, Helvetica, sans-serif;
                                                    font-size: 14px;
                                                "
                                            >
                                                We have responded to your support request
                                            </p>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>

                        <!-- Content -->
                        <tr>
                            <td
                                class="content-padding"
                                style="padding: 36px 40px; background-color: #ffffff"
                            >
                                <table
                                    role="presentation"
                                    cellspacing="0"
                                    cellpadding="0"
                                    border="0"
                                    width="100%"
                                >
                                    <!-- Greeting -->
                                    <tr>
                                        <td style="padding: 0 0 24px 0">
                                            <p
                                                style="
                                                    margin: 0;
                                                    color: #333333;
                                                    font-family: Arial, Helvetica, sans-serif;
                                                    font-size: 16px;
                                                    line-height: 1.5;
                                                "
                                            >
                                                Hello <strong><%= userName %></strong>,
                                            </p>
                                        </td>
                                    </tr>

                                    <!-- Intro -->
                                    <tr>
                                        <td style="padding: 0 0 24px 0">
                                            <p
                                                style="
                                                    margin: 0;
                                                    color: #666666;
                                                    font-family: Arial, Helvetica, sans-serif;
                                                    font-size: 14px;
                                                    line-height: 1.6;
                                                "
                                            >
                                                Thank you for contacting our support team. We have
                                                reviewed your request and here is our response:
                                            </p>
                                        </td>
                                    </tr>

                                    <!-- Original Ticket -->
                                    <tr>
                                        <td style="padding: 0 0 16px 0">
                                            <div
                                                class="ticket-box"
                                                style="
                                                    background-color: #f5f5f5;
                                                    padding: 20px 24px;
                                                    border-radius: 8px;
                                                "
                                            >
                                                <table
                                                    role="presentation"
                                                    cellspacing="0"
                                                    cellpadding="0"
                                                    border="0"
                                                    width="100%"
                                                >
                                                    <tr>
                                                        <td style="padding: 0 0 12px 0">
                                                            <p
                                                                style="
                                                                    margin: 0;
                                                                    color: #666666;
                                                                    font-family:
                                                                        Arial, Helvetica, sans-serif;
                                                                    font-size: 13px;
                                                                    text-transform: uppercase;
                                                                    letter-spacing: 0.5px;
                                                                "
                                                                class="ticket-label"
                                                            >
                                                                Subject
                                                            </p>
                                                            <p
                                                                style="
                                                                    margin: 4px 0 0 0;
                                                                    color: #333333;
                                                                    font-family:
                                                                        Arial, Helvetica, sans-serif;
                                                                    font-size: 16px;
                                                                    font-weight: 600;
                                                                "
                                                            >
                                                                <%= subject %>
                                                            </p>
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <td
                                                            style="
                                                                padding: 12px 0 0 0;
                                                                border-top: 1px solid #e5e5e5;
                                                            "
                                                        >
                                                            <p
                                                                style="
                                                                    margin: 0 0 8px 0;
                                                                    color: #666666;
                                                                    font-family:
                                                                        Arial, Helvetica, sans-serif;
                                                                    font-size: 13px;
                                                                    text-transform: uppercase;
                                                                    letter-spacing: 0.5px;
                                                                "
                                                                class="ticket-label"
                                                            >
                                                                Description
                                                            </p>
                                                            <p
                                                                style="
                                                                    margin: 0;
                                                                    color: #666666;
                                                                    font-family:
                                                                        Arial, Helvetica, sans-serif;
                                                                    font-size: 14px;
                                                                    line-height: 1.6;
                                                                    white-space: pre-wrap;
                                                                "
                                                            >
                                                                <%= description %>
                                                            </p>
                                                        </td>
                                                    </tr>
                                                </table>
                                            </div>
                                        </td>
                                    </tr>

                                    <!-- Admin Response -->
                                    <tr>
                                        <td style="padding: 0 0 16px 0">
                                            <p
                                                style="
                                                    margin: 0 0 12px 0;
                                                    color: #333333;
                                                    font-family: Arial, Helvetica, sans-serif;
                                                    font-size: 14px;
                                                    font-weight: 600;
                                                "
                                            >
                                                Our Response:
                                            </p>
                                            <div
                                                style="
                                                    background-color: #e8f5e9;
                                                    padding: 20px 24px;
                                                    border-radius: 8px;
                                                    border-left: 4px solid #4caf50;
                                                "
                                            >
                                                <p
                                                    style="
                                                        margin: 0;
                                                        color: #333333;
                                                        font-family: Arial, Helvetica, sans-serif;
                                                        font-size: 14px;
                                                        line-height: 1.6;
                                                    "
                                                >
                                                    <%= reply %>
                                                </p>
                                            </div>
                                        </td>
                                    </tr>

                                    <!-- Closing -->
                                    <tr>
                                        <td style="padding: 24px 0 0 0">
                                            <p
                                                style="
                                                    margin: 0;
                                                    color: #666666;
                                                    font-family: Arial, Helvetica, sans-serif;
                                                    font-size: 14px;
                                                    line-height: 1.6;
                                                "
                                            >
                                                If you have any further questions, please feel free
                                                to submit a new support request.
                                            </p>
                                        </td>
                                    </tr>

                                    <!-- Signature -->
                                    <tr>
                                        <td style="padding: 24px 0 0 0">
                                            <p
                                                style="
                                                    margin: 0;
                                                    color: #666666;
                                                    font-family: Arial, Helvetica, sans-serif;
                                                    font-size: 14px;
                                                    line-height: 1.6;
                                                "
                                            >
                                                Best regards,<br />
                                                <strong>The Support Team</strong>
                                            </p>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>

                        <!-- Footer -->
                        <tr>
                            <td
                                class="footer-cell"
                                style="padding: 24px 40px 28px; background-color: #f5f5f5"
                            >
                                <table
                                    role="presentation"
                                    cellspacing="0"
                                    cellpadding="0"
                                    border="0"
                                    width="100%"
                                >
                                    <tr>
                                        <td style="padding: 0 0 16px 0; text-align: center">
                                            <p
                                                style="
                                                    margin: 0;
                                                    color: #999999;
                                                    font-family: Arial, Helvetica, sans-serif;
                                                    font-size: 12px;
                                                "
                                            >
                                                &copy; <%= new Date().getFullYear() %> Lense Tribe.
                                                All rights reserved.
                                            </p>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>
    </body>
</html>
