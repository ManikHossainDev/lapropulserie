<!doctype html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Ton bilan gratuit — La Propulserie</title>
</head>
<body style="margin:0;padding:0;background:#f0f2f5;font-family:Arial,Helvetica,sans-serif;">
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background:#f0f2f5;padding:24px 12px;">
    <tr>
      <td align="center">
        <table role="presentation" width="100%" style="max-width:560px;background:#ffffff;border-radius:16px;overflow:hidden;">
          <tr>
            <td style="background:#2d2a71;padding:28px 24px;text-align:center;">
              <div style="font-size:28px;margin-bottom:8px;">🚀</div>
              <h1 style="margin:0;color:#ffffff;font-size:22px;">La Propulserie</h1>
              <p style="margin:8px 0 0;color:#c5d0e6;font-size:14px;">Bilan professionnel gratuit</p>
            </td>
          </tr>
          <tr>
            <td style="padding:28px 24px;color:#1a1a2e;">
              <p style="margin:0 0 12px;font-size:16px;">Bonjour <strong><%= friendName %></strong>,</p>
              <p style="margin:0 0 16px;font-size:15px;line-height:1.5;color:#4a5568;">
                <strong><%= senderName %></strong> pense à toi et t’invite à réaliser ton
                <strong>bilan professionnel gratuit</strong> avec La Propulserie —
                environ 15 minutes pour faire le point et recevoir une première analyse personnalisée.
              </p>
              <p style="text-align:center;margin:28px 0;">
                <a href="<%= bilanUrl %>"
                   style="display:inline-block;background:linear-gradient(135deg,#f5a623,#e8870a);color:#fff;text-decoration:none;font-weight:bold;padding:14px 28px;border-radius:8px;">
                  Faire mon bilan gratuit
                </a>
              </p>
              <p style="margin:0;font-size:13px;color:#8898b8;line-height:1.4;">
                Si le bouton ne fonctionne pas, copie ce lien dans ton navigateur :<br />
                <a href="<%= bilanUrl %>" style="color:#2d2a71;word-break:break-all;"><%= bilanUrl %></a>
              </p>
            </td>
          </tr>
          <tr>
            <td style="padding:16px 24px 24px;text-align:center;font-size:12px;color:#a0aec0;">
              <%= typeof appName !== 'undefined' ? appName : 'La Propulserie' %>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
