<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Paiement réussi</title>
    <style>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        font-family: Arial, sans-serif;
        background-color: #e8f5e9;
      }

      .container {
        text-align: center;
        padding: 2rem;
        background: #ffffff;
        border-radius: 10px;
        box-shadow: 0 4px 12px rgba(0, 128, 0, 0.2);
        max-width: 500px;
        width: 90%;
      }

      .success-icon {
        font-size: 4rem;
        color: #4caf50;
        margin-bottom: 1rem;
      }

      h1 {
        color: #2e7d32;
        margin-bottom: 1rem;
      }

      p {
        color: #388e3c;
        margin-bottom: 2rem;
      }

      .details {
        text-align: left;
        margin-bottom: 2rem;
        color: #2e7d32;
        line-height: 1.7;
        overflow-wrap: anywhere;
        word-break: break-word;
      }

      .details div {
        margin-bottom: 0.35rem;
      }

      .btn-home {
        display: inline-block;
        padding: 0.5rem 1.5rem;
        color: #fff;
        background-color: #4caf50;
        text-decoration: none;
        border-radius: 5px;
        transition: background-color 0.3s;
      }

      .btn-home:hover {
        background-color: #388e3c;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="success-icon">✔️</div>
      <h1>Merci pour votre paiement !</h1>
      <p>Votre transaction a été effectuée avec succès.</p>

      <div class="details">
        <div><strong>Client :</strong> <%= data.customerName %></div>
        <div><strong>Email :</strong> <%= data.customerEmail %></div>
        <div><strong>Produit :</strong> <%= data.planNickname %></div>
        <div><strong>Type :</strong> <%= data.subscriptionType %></div>
        <div><strong>Montant :</strong> <%= Number(data.amountTotal || 0).toLocaleString('fr-FR') %> <%= data.currency %></div>
        <div><strong>Statut :</strong> <%= data.paymentStatus === 'paid' || data.paymentStatus === 'completed' ? 'Payé' : data.paymentStatus %></div>
        <div><strong>Session :</strong> <%= data.sessionId %></div>
        <% if (data.subscriptionId) { %>
          <div><strong>Abonnement :</strong> <%= data.subscriptionId %></div>
        <% } %>
      </div>

      <a href="<%= data.frontEndHomePageUrl || '/' %>" class="btn-home">Retour à l'accueil</a>
    </div>
  </body>
</html>
